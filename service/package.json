{
  "name": "@content-lab/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "doctor": "tsx src/doctor.ts",
    "feishu:onboard": "tsx src/feishu-onboard.ts",
    "feishu:doctor": "tsx src/feishu-doctor.ts",
    "feishu:configure": "tsx src/feishu-configure.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
